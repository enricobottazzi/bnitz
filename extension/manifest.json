{
  "manifest_version": 3,
  "name": "BNITZ",
  "description": "Map arXiv abstracts and highlight related passages throughout the full PDF.",
  "version": "0.1.4",
  "minimum_chrome_version": "151",
  "icons": {
    "16": "icons/bnitz-16.png",
    "32": "icons/bnitz-32.png",
    "48": "icons/bnitz-48.png",
    "128": "icons/bnitz-128.png"
  },
  "action": {"default_title": "BNITZ", "default_icon": {"16": "icons/bnitz-16.png", "32": "icons/bnitz-32.png"}},
  "background": {"service_worker": "dist/reader/background.mjs", "type": "module"},
  "side_panel": {"default_path": "dist/reader/index.html"},
  "mime_types_handler": {"application/pdf": {"handler_url": "dist/reader/pdf.html"}},
  "permissions": ["sidePanel"],
  "host_permissions": ["https://arxiv.org/*", "https://www.arxiv.org/*", "https://bnitz-routing.enricobottazzi.workers.dev/*"]
}
